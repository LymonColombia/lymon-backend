/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carts {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guest_account_id String             @unique(map: "carts_guest_account_id_idx", where: raw("(status = 'OPEN'::text)")) @db.Uuid
  experience_items Json               @default("[]")
  reservation_item Json?
  status           String             @default("OPEN")
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  guest_accounts   guest_accounts     @relation(fields: [guest_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_sessions payment_sessions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model experiences {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String                 @db.Uuid
  scope                      String
  property_id                String?                @db.Uuid
  name                       String
  description                String
  city                       String
  category                   String
  price_cop                  BigInt
  minimum_participants       Int                    @default(1)
  capacity                   Int
  availability_type          String
  recurrence                 Json?
  allow_standalone_purchase  Boolean                @default(true)
  allow_reservation_purchase Boolean                @default(true)
  min_notice_hours           Int                    @default(0)
  purchase_cutoff_hours      Int                    @default(0)
  media_keys                 String[]               @default([])
  status                     String                 @default("ACTIVE")
  created_at                 DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                 DateTime?              @db.Timestamptz(6)
  experience_purchases       experience_purchases[]
  properties                 properties?            @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants                    tenants                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, status], where: raw("(deleted_at IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model experience_purchases {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String         @db.Uuid
  guest_account_id  String         @db.Uuid
  experience_id     String         @db.Uuid
  reservation_id    String?        @db.Uuid
  selected_date     DateTime?      @db.Date
  quantity          Int
  unit_price_cop    BigInt
  total_price_cop   BigInt
  status            String         @default("PENDING")
  payment_reference String?
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)
  experiences       experiences    @relation(fields: [experience_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guest_accounts    guest_accounts @relation(fields: [guest_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservations      reservations?  @relation(fields: [reservation_id], references: [id], onUpdate: NoAction)
  tenants           tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([experience_id, selected_date], where: raw("(status <> 'CANCELLED'::text)"))
  @@index([guest_account_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment_sessions {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String         @db.Uuid
  guest_account_id    String         @db.Uuid
  cart_id             String         @db.Uuid
  reference           String         @unique
  amount_in_cents     BigInt
  currency            String         @default("COP") @db.Char(3)
  public_key          String
  signature_integrity String
  redirect_url        String?
  expiration_time     DateTime?      @db.Timestamptz(6)
  provider_reference  String?        @unique(map: "payment_sessions_provider_reference_idx", where: raw("(provider_reference IS NOT NULL)"))
  status              String         @default("PENDING")
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  carts               carts          @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guest_accounts      guest_accounts @relation(fields: [guest_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants             tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([cart_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model refund_requests {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String       @db.Uuid
  reservation_id String       @db.Uuid
  guest_id       String       @db.Uuid
  amount         Decimal      @db.Decimal(14, 2)
  status         String       @default("PENDING")
  requested_by   String
  reviewed_by    String?      @db.Uuid
  reviewed_at    DateTime?    @db.Timestamptz(6)
  reason         String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
