/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversations {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String           @db.Uuid
  guest_id               String           @db.Uuid
  reservation_id         String?          @db.Uuid
  channels               String[]         @default([])
  subject                String
  last_message_at        DateTime         @default(now()) @db.Timestamptz(6)
  last_message_preview   String           @default("")
  unread_count_for_staff Int              @default(0)
  unread_count_for_guest Int              @default(0)
  status                 String           @default("open")
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @db.Timestamptz(6)
  guests                 guests           @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reservations           reservations?    @relation(fields: [reservation_id], references: [id], onUpdate: NoAction)
  tenants                tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest_messages         guest_messages[]

  @@index([guest_id])
  @@index([tenant_id, status, last_message_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guest_messages {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String         @db.Uuid
  guest_id            String         @db.Uuid
  conversation_id     String?        @db.Uuid
  reservation_id      String?        @db.Uuid
  channel             String
  direction           String
  status              String
  from_address        String
  to_addresses        String[]
  provider            String?
  provider_message_id String?
  template_id         String?
  sent_by_actor_id    String?        @db.Uuid
  sent_by_actor_email String?        @db.Citext
  attachments         Json           @default("[]")
  preview             String
  body                String?
  body_html           String?
  failure_reason      String?
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?      @db.Timestamptz(6)
  conversations       conversations? @relation(fields: [conversation_id], references: [id], onUpdate: NoAction)
  guests              guests         @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reservations        reservations?  @relation(fields: [reservation_id], references: [id], onUpdate: NoAction)
  tenants             tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_message_id], map: "guest_messages_provider_provider_message_id_idx", where: raw("(provider_message_id IS NOT NULL)"))
  @@index([conversation_id, created_at])
  @@index([tenant_id, guest_id, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guest_emails {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  guest_id    String   @db.Uuid
  subject     String
  status      String
  attachments Json     @default("[]")
  message_id  String?
  sent_by_id  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  guests      guests   @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?   @relation(fields: [sent_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants     tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, guest_id, created_at(sort: Desc)])
}
