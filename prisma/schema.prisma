generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/persistence/prisma/generated"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String   @db.Uuid
  user_id        String   @db.Uuid
  user_email     String   @db.Citext
  action         String
  entity_type    String
  entity_id      String?  @db.Uuid
  metadata       Json?
  previous_value Json?
  new_value      Json?
  ip_address     String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  tenants        tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entity_type, entity_id])
  @@index([tenant_id, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carts {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guest_account_id String             @unique(map: "carts_guest_account_id_idx", where: raw("(status = 'OPEN'::text)")) @db.Uuid
  experience_items Json               @default("[]")
  reservation_item Json?
  status           String             @default("OPEN")
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  guest_accounts   guest_accounts     @relation(fields: [guest_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_sessions payment_sessions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversations {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String           @db.Uuid
  guest_id               String           @db.Uuid
  reservation_id         String?          @db.Uuid
  channels               String[]         @default([])
  subject                String
  last_message_at        DateTime         @default(now()) @db.Timestamptz(6)
  last_message_preview   String           @default("")
  unread_count_for_staff Int              @default(0)
  unread_count_for_guest Int              @default(0)
  status                 String           @default("open")
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @db.Timestamptz(6)
  guests                 guests           @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reservations           reservations?    @relation(fields: [reservation_id], references: [id], onUpdate: NoAction)
  tenants                tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest_messages         guest_messages[]

  @@index([guest_id])
  @@index([tenant_id, status, last_message_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model experience_purchases {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String         @db.Uuid
  guest_account_id  String         @db.Uuid
  experience_id     String         @db.Uuid
  reservation_id    String?        @db.Uuid
  selected_date     DateTime?      @db.Date
  quantity          Int
  unit_price_cop    BigInt
  total_price_cop   BigInt
  status            String         @default("PENDING")
  payment_reference String?
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)
  experiences       experiences    @relation(fields: [experience_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guest_accounts    guest_accounts @relation(fields: [guest_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservations      reservations?  @relation(fields: [reservation_id], references: [id], onUpdate: NoAction)
  tenants           tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([experience_id, selected_date], where: raw("(status <> 'CANCELLED'::text)"))
  @@index([guest_account_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
