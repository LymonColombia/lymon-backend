JWT_SECRET = your_jwt_secret_key
APP_URL=YOUR_APP_URL

# Cloudflare R2 Storage
R2_ACCOUNT_ID=accountid
R2_ACCESS_KEY_ID=accesskey
R2_SECRET_ACCESS_KEY=secretaccesskey
R2_BUCKET_NAME=bucket_name
R2_PUBLIC_URL=https://your-r2-public-url

# Email webhook (Brevo)
EMAIL_INBOUND_ENABLED=false
EMAIL_WEBHOOK_SECRET=
# Matches the docker-compose.yml defaults, so this works as-is with `pnpm db:up`
DATABASE_URL="postgresql://lymon:lymon@127.0.0.1:5433/lymon?schema=public"

# Seeds dev fixtures on boot (roles, guest tags, a tenant + owner, a property and a
# unit) so a fresh database is usable without creating them by hand. Must be the
# literal string "true"; leave it unset anywhere that is not a dev machine.
isDevelopment=true
