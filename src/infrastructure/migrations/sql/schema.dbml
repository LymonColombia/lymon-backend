Table "shifts" [headercolor: #16A085, note: 'src/domain/shift/entities/shift.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "property_id" uuid [not null]
  "name" text [not null]
  "start_date" date [not null]
  "end_date" date
  "start_hour" time [not null]
  "end_hour" time [not null]
  "start_minutes" integer [not null, check: `start_minutes BETWEEN 0 AND 1439`]
  "end_minutes" integer [not null, check: `end_minutes   BETWEEN 0 AND 1439`]
  "weekdays" "smallint[]"
  "notes" text
  "created_by" uuid
  "created_by_email" citext
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `end_date IS NULL OR end_date >= start_date`
  }

  Indexes {
    (tenant_id, property_id, start_date)
  }
}

Table "shift_staff_members" [headercolor: #16A085, note: 'src/domain/shift/entities/shift.entity.ts (Shift.staffMemberIds)'] {
  "shift_id" uuid [not null]
  "user_id" uuid [not null]

  Indexes {
    (shift_id, user_id) [pk]
    user_id
  }
}

Table "incident_reports" [headercolor: #16A085, note: 'src/domain/incident-report/entities/incident-report.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "property_id" uuid [not null]
  "created_by" uuid [not null]
  "title" text [not null]
  "description" text [not null]
  "attachment_urls" "text[]" [not null, default: '{}']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (property_id, created_at)
  }
}

Table "suppliers" [headercolor: #5D6D7E, note: 'src/domain/inventory/entities/supplier.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "name" text [not null]
  "contact_email" citext [not null]
  "contact_phone" text [not null]
  "country" text [not null]
  "city" text [not null]
  "nit" text [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (tenant_id, nit) [unique]
  }
}

Table "inventory_item_categories" [headercolor: #5D6D7E, note: 'src/domain/inventory/entities/inventory-item-category.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "name" text [not null]
  "description" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, name) [unique]
  }
}

Table "inventory_items" [headercolor: #5D6D7E, note: 'src/domain/inventory/entities/inventory-item.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "property_id" uuid [not null]
  "sku" text [not null]
  "name" text [not null]
  "category_id" uuid [not null]
  "unit" text [not null]
  "min_stock" numeric(14,3) [not null, check: `min_stock >= 0`, default: 0]
  "current_stock" numeric(14,3) [not null, check: `current_stock >= 0`, default: 0]
  "supplier_id" uuid
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (tenant_id, property_id, sku) [unique, note: 'partial: WHERE deleted_at IS NULL']
    property_id
    tenant_id
  }
}

Table "inventory_movements" [headercolor: #5D6D7E, note: 'src/domain/inventory/entities/inventory-movement.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "property_id" uuid [not null]
  "item_id" uuid [not null]
  "type" text [not null, check: `type IN ('IN', 'OUT', 'ADJUSTMENT')`]
  "quantity" numeric(14,3) [not null, check: `quantity > 0`]
  "reason" text [not null]
  "reference" text
  "actor_id" uuid [not null]
  "actor_email" citext [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (item_id, created_at)
  }
}

Table "audit_logs" [headercolor: #566573, note: 'src/domain/audit/entities/audit-log.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "user_id" uuid [not null]
  "user_email" citext [not null]
  "action" text [not null, note: 'AuditAction enum, src/domain/audit/value-objects/audit-action.vo.ts']
  "entity_type" text [not null]
  "entity_id" uuid
  "metadata" jsonb
  "previous_value" jsonb
  "new_value" jsonb
  "ip_address" text
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `entity_type IN (
    'AUTH', 'TENANT', 'USER', 'PROPERTY', 'UNIT', 'INCIDENT_REPORT', 'RESERVATION', 'SHIFT',
    'SUPPLIER', 'EXPERIENCE', 'EXPERIENCE_PURCHASE', 'CART', 'UNIT_RATING', 'GUEST_NOTE',
    'GUEST', 'GUEST_EMAIL', 'GUEST_CATALOG_ITEM'
  )` [name: 'entity_type_values']
  }

  Indexes {
    (tenant_id, created_at)
    (entity_type, entity_id)
  }
}

