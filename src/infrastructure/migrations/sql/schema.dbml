Table "guest_preference_catalog_items" [headercolor: #B5651D, note: 'src/domain/guest-preference/entities/guest-preference-catalog-item.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "category" text [not null, check: `category IN ('DIETARY', 'ROOM', 'ACCESSIBILITY', 'OTHER')`]
  "source" text [not null, check: `source IN ('PREDEFINED', 'CUSTOM')`]
  "key" text
  "label" text
  "is_active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `(source = 'PREDEFINED' AND key IS NOT NULL)
      OR (source = 'CUSTOM'     AND label IS NOT NULL)`
    `key IS NULL OR key IN (
    'VEGAN', 'VEGETARIAN', 'GLUTEN_FREE', 'LOW_SUGAR', 'NUT_ALLERGY', 'LACTOSE_FREE',
    'HALAL', 'KOSHER', 'HIGH_FLOOR', 'LOW_FLOOR', 'QUIET_ROOM', 'SMOKING',
    'NON_SMOKING', 'EXTRA_PILLOWS', 'FOAM_PILLOW', 'FEATHER_PILLOW', 'EXTRA_BLANKET',
    'HANDICAP_ACCESSIBLE', 'WHEELCHAIR_ACCESSIBLE', 'ROLL_IN_SHOWER', 'GRAB_BARS',
    'VISUAL_ALERTS'
  )` [name: 'key_values']
  }

  Indexes {
    (tenant_id, category, key) [unique]
    tenant_id
  }
}

Table "guest_notes" [headercolor: #B5651D, note: 'src/domain/guest-note/entities/guest-note.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "guest_id" uuid [not null]
  "note" text [not null]
  "type" text [not null, check: `type IN ('preference', 'behavior', 'incident', 'general')`, default: 'general']
  "status" text [not null, check: `status IN ('is_pinned', 'not_pinned')`, default: 'not_pinned']
  "created_by" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    guest_id
  }
}

Table "conversations" [headercolor: #7D3C98, note: 'src/domain/conversation/entities/conversation.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "guest_id" uuid [not null]
  "reservation_id" uuid
  "channels" "text[]" [not null, default: '{}']
  "subject" text [not null]
  "last_message_at" timestamptz [not null, default: `now()`]
  "last_message_preview" text [not null, default: '']
  "unread_count_for_staff" integer [not null, check: `unread_count_for_staff >= 0`, default: 0]
  "unread_count_for_guest" integer [not null, check: `unread_count_for_guest >= 0`, default: 0]
  "status" text [not null, check: `status IN ('open', 'archived', 'snoozed')`, default: 'open']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `channels <@ ARRAY[
    'email'
  ]::text[]` [name: 'channels_values']
  }

  Indexes {
    (tenant_id, status, last_message_at)
    guest_id
  }
}

Table "guest_messages" [headercolor: #7D3C98, note: 'src/domain/guest-message/entities/guest-message.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "guest_id" uuid [not null]
  "conversation_id" uuid
