Project lymon {
  database_type: 'PostgreSQL'
  Note: '''ERD generated from docs/postgres-schema.sql, which maps src/domain entities 1:1.
Enums live in TypeScript; the DB stores text and validates with CHECK (col IN (...)) - the
allowed values show up on each column. Paste into https://dbdiagram.io.'''
}

Table "tenants" [headercolor: #2E86AB, note: 'src/domain/tenant/entities/tenant.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "name" text [not null, check: `btrim(name) <> ''`]
  "slug" text [unique, not null]
  "owner_email" citext [not null]
  "plan" text [not null, check: `plan IN ('LYMON_ONE', 'LYMON_PLUS', 'LYMON_PRIME', 'TRIAL')`]
  "email_verified" boolean [not null, default: false]
  "contact_phone" text
  "address" text
  "description" text
  "logo_key" text
  "theme" jsonb
  "trial_ends_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
}

Table "roles" [headercolor: #2E86AB, note: 'src/domain/role/entities/role.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "name" text [unique, not null]
  "permissions" "text[]" [not null, default: '{}', note: 'Permission enum, src/domain/role/value-objects/permission.vo.ts']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "users" [headercolor: #2E86AB, note: 'src/domain/user/entities/user.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "email" citext [not null]
  "password_hash" text [not null]
  "is_owner" boolean [not null, default: false]
  "email_verified" boolean [not null, default: false]
  "full_name" text
  "document" text
  "tutorial_completed" boolean [not null, default: false]
  "reset_password_token" text
  "reset_password_expires" timestamptz
  "password_changed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (tenant_id, email) [unique, name: 'users_unique_active_email_tenant', note: 'partial: WHERE deleted_at IS NULL']
    (tenant_id, deleted_at)
    (tenant_id, id) [unique, note: 'FK target, see user_role_assignments']
  }
}

Table "user_role_assignments" [headercolor: #2E86AB, note: 'src/domain/user/entities/user.entity.ts (RoleAssignment[]) - one row per scoped resource; the repository regroups them into the array the JWT expects'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "user_id" uuid [not null]
  "role_id" uuid [not null]
  "scope_type" text [not null, check: `scope_type IN ('TENANT', 'PROPERTY', 'UNIT')`]
  "property_id" uuid [note: 'NULL for TENANT scope']
  "unit_id" uuid [note: "NULL unless scope_type = 'UNIT'"]

  Checks {
    `(scope_type = 'TENANT' AND property_id IS NULL AND unit_id IS NULL) OR (scope_type = 'PROPERTY' AND property_id IS NOT NULL AND unit_id IS NULL) OR (scope_type = 'UNIT' AND property_id IS NOT NULL AND unit_id IS NOT NULL)`
  }

  Indexes {
    (user_id, role_id, scope_type, property_id, unit_id) [unique, note: 'NULLS NOT DISTINCT']
    user_id
    (tenant_id, property_id)
  }
}

Table "properties" [headercolor: #3F7D20, note: 'src/domain/property/entities/property.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "name" text [not null]
  "slug" text [not null]
  "description" text [not null]
  "property_type" text [not null, check: `property_type IN ('HOTEL', 'CASA', 'APARTAMENTO', 'VILLA', 'HOSTAL', 'GLAMPING')`]
  "address" text [not null]
  "city" text [not null]
  "state" text [not null]
  "country" text [not null]
  "zip_code" text [not null]
  "lat" numeric(9,6) [not null]
  "lng" numeric(9,6) [not null]
  "check_in_time" time [not null]
  "check_out_time" time [not null]
  "cancellation_policy" text [not null, check: `cancellation_policy IN ('FLEXIBLE', 'STANDARD', 'STRICT')`]
  "host_phone" text [not null]
  "host_email" citext [not null]
  "image_key" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (tenant_id, slug) [unique]
    (tenant_id, id) [unique, note: 'FK target: children pin (tenant_id, property_id) together']
    tenant_id
  }
}

Table "units" [headercolor: #3F7D20, note: 'src/domain/unit/entities/unit.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "property_id" uuid [not null]
  "name" text [not null]
  "description" text [not null]
  "inventory_count" integer [not null, check: `inventory_count >= 0`]
  "max_guests" integer [not null, check: `max_guests > 0`]
  "standard_guests" integer [not null, check: `standard_guests > 0`]
  "bedrooms" jsonb [not null, default: '[]']
  "bathrooms_count" integer [not null, check: `bathrooms_count >= 0`]
  "is_shared" boolean [not null, default: false]
  "amenities" "text[]" [not null, default: '{}']
  "media_keys" "text[]" [not null, default: '{}']
  "price_per_night" numeric(14,2) [not null, check: `price_per_night >= 0`]
  "rating" numeric(2,1) [check: `rating BETWEEN 0 AND 5`]
  "external_airbnb_id" text
  "external_booking_id" text
  "external_vrbo_id" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Checks {
    `standard_guests <= max_guests`
  }

  Indexes {
    (tenant_id, property_id, id) [unique, note: 'FK target for reservations']
    tenant_id
    property_id
  }
}

