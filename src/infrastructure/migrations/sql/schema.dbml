  "channel" text [not null, check: `channel IN ('email')`]
  "direction" text [not null, check: `direction IN ('inbound', 'outbound')`]
  "status" text [not null, check: `status IN ('queued', 'pending', 'sent', 'delivered', 'read', 'failed', 'bounced')`]
  "from_address" text [not null]
  "to_addresses" "text[]" [not null, check: `cardinality(to_addresses) > 0`]
  "provider" text
  "provider_message_id" text
  "template_id" text
  "sent_by_actor_id" uuid
  "sent_by_actor_email" citext
  "attachments" jsonb [not null, default: '[]']
  "preview" text [not null]
  "body" text
  "body_html" text
  "failure_reason" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz

  Indexes {
    (conversation_id, created_at)
    (tenant_id, guest_id, created_at)
    (provider, provider_message_id) [unique]
  }
}

Table "guest_emails" [headercolor: #7D3C98, note: 'src/domain/guest-email/entities/guest-email.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "guest_id" uuid [not null]
  "subject" text [not null]
  "status" text [not null, check: `status IN ('pending', 'sent', 'failed')`]
  "attachments" jsonb [not null, default: '[]']
  "message_id" text
  "sent_by_id" uuid
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, guest_id, created_at)
  }
}

Table "reservations" [headercolor: #C0392B, note: 'src/domain/reservation/entities/reservation.entity.ts'] {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "tenant_id" uuid [not null]
  "property_id" uuid [not null]
  "unit_id" uuid [not null]
  "guest_id" uuid [not null]
  "check_in" date [not null]
  "check_out" date [not null]
  "source" text [not null, check: `source IN ('MANUAL', 'DIRECT')`]
  "status" text [not null, check: `status IN ('PENDING', 'CONFIRMED', 'CHECKED_IN', 'CHECKED_OUT', 'CANCELLED', 'NO_SHOW')`, default: 'PENDING']
  "guests_count" integer [not null, check: `guests_count > 0`]
  "price_per_night" numeric(14,2) [not null, check: `price_per_night >= 0`]
  "total_price" numeric(14,2) [not null, check: `total_price >= 0`]
  "notes" text
  "reservation_number" bigint [note: 'per-tenant customer-visible number; max(+1) on insert, guarded by the unique index']
  "external_reservation_id" text
  "check_in_info" jsonb [not null, default: '[]']
  "cancelled_at" timestamptz
  "cancellation_reason" text
  "check_in_actual_at" timestamptz
  "check_out_actual_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `check_out > check_in`
  }

  Indexes {
    (tenant_id, reservation_number) [unique]
    (tenant_id, status)
    guest_id
    (unit_id, check_in, check_out)
  }
}

