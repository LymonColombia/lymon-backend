# k6 environment variables
# Usage example:
# export $(grep -v '^#' performance/k6/.env.k6 | xargs) && pnpm run perf:k6:smoke

# Required for all tests
BASE_URL=http://localhost:3000

# Required for smoke login
AUTH_EMAIL=villajaramillofelipe4@gmail.com
AUTH_PASSWORD=SecurePass123!

# Optional for authenticated load tests (if omitted, login fallback is used)
TOKEN=
# Optional for incident reports when TOKEN is provided
CREATED_BY=

# Required for inventory load test and units load test
PROPERTY_ID=69d96bc1de51ea1f09cd03ae

# Optional
PAGE=1
LIMIT=20
THINK_TIME=1
